// Modele : CMake le recopie dans le dossier de compilation en y mettant
// la version ecrite dans CMakeLists.txt. Ne jamais ecrire de version ici.
IDI_ICON1 ICON "@DM_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "Debrid Manager"
      VALUE "ProductName", "Debrid Manager"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
